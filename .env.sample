# Local runtime
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:15432/knowledge
DB_USERNAME=knowledge
DB_PASSWORD=knowledge

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=knowledge-management-service
KAFKA_TOPIC_TICKET_MANAGEMENT_EVENTS=ticket-management-events
KAFKA_TOPIC_ORGANIZATION_ACCESS_EVENTS=organization-access-events

# Outbound topic consumed by ticket-management.
# This intentionally follows current ticket-management config.
KAFKA_TOPIC_KNOWLEDGE_MANAGEMENT_EVENTS=knowledge-base-events
KAFKA_TOPIC_KNOWLEDGE_MANAGEMENT_DLT=knowledge-base-events-dlt

# Security / Keycloak
JWT_ISSUER_URI=http://localhost:8085/realms/supporthub
JWT_AUDIENCE=knowledge-management-service

# Published article event type.
EVENT_KNOWLEDGE_ARTICLE_PUBLISHED=KnowledgeArticleApproved

# Article generation
ARTICLE_GENERATION_PROVIDER=openai
ARTICLE_GENERATION_MODEL=gpt-5.4-mini
ARTICLE_GENERATION_MAX_OUTPUT_TOKENS=2500
ARTICLE_GENERATION_MAX_CONTENT_LENGTH=16000
ARTICLE_GENERATION_SAFE_LOGGING_ENABLED=true
ARTICLE_GENERATION_SAFE_GUARD_ENABLED=false

# OpenAI
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key
